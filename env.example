# =============================================================================
#  env.example — App QLCL KPI (server trung tâm)
# =============================================================================
#
#  CÁCH SỬ DỤNG:
#    1. Copy file này thành `.env` (cùng thư mục):
#         Copy-Item env.example .env        (PowerShell)
#         copy env.example .env             (CMD)
#    2. Điền giá trị thực vào từng dòng bên dưới
#    3. KHÔNG commit file .env lên Git (đã có trong .gitignore)
#
#  Xem DEPLOY.md để biết hướng dẫn chi tiết từng bước.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE POSTGRESQL (BẮT BUỘC)
# -----------------------------------------------------------------------------
# Format: postgresql://username:password@host:port/database
#
# Ví dụ local:
#   DATABASE_URL=postgresql://postgres:matkhau123@localhost:5432/qlcl
# Ví dụ server (production):
#   DATABASE_URL=postgresql://qlcl_user:matkhau_manh@db.hachibavn.com:5432/qlcl

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/qlcl
PROD_FACTORY_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/prod_factory
GEMBA_CP_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/gemba_cp


# -----------------------------------------------------------------------------
# ĐƯỜNG DẪN THƯ MỤC (BẮT BUỘC — sửa theo máy thực tế)
# -----------------------------------------------------------------------------
# Trên Windows dùng đường dẫn tuyệt đối. Có thể dùng / hoặc \ đều được.
# Trên Linux server: /home/ubuntu/qlcl/templates  (v.v.)
#
# Ví dụ Windows local:
#   TEMPLATES_DIR=D:\KPI\qlcl\templates
# Ví dụ Linux server:
#   TEMPLATES_DIR=/opt/qlcl/templates

TEMPLATES_DIR=D:\Data Analyst\Tools\kpi\qlcl\templates
EXCEL_TEMPLATE_PATH=D:\Data Analyst\Tools\kpi\qlcl\templates\10.1-bm1.xlsx
PDF_STORAGE_DIR=D:\Data Analyst\Tools\kpi\qlcl\pdf_files
IMAGES_STORAGE_DIR=D:\Data Analyst\Tools\kpi\qlcl\images


# -----------------------------------------------------------------------------
# GEMBA CONTROL PLAN (bỏ trống nếu không dùng module này)
# -----------------------------------------------------------------------------
GEMBA_CP_APP_NAME=Gemba CP Dashboard
GEMBA_CP_GOOGLE_SHEETS_SPREADSHEET_ID=1mqnn7_xXdo0rY7zEjZm2T9KHQpsRfeCxsS6fitkQlns
GEMBA_CP_GOOGLE_SHEETS_WORKSHEET=GEMBACP
GEMBA_CP_GOOGLE_SERVICE_ACCOUNT_FILE=D:\Data Analyst\Tools\kpi\qlcl\gemba_cp\templates\credentials_m29.json
GEMBA_CP_GOOGLE_SHEETS_RANGE=


# -----------------------------------------------------------------------------
# TÍCH HỢP CHUYỀN TREO — MULTI-FACTORY
# -----------------------------------------------------------------------------

# Đơn vị mặc định khi không có thông tin trong payload.
# Chỉ có ý nghĩa trong môi trường dev local (1 XN).
# Trong production: giá trị don_vi được gửi kèm từ mỗi app XN, không dùng biến này.
QLCL_DON_VI=XN3

# API key để xác thực các request đẩy dữ liệu từ app chuyền treo (XN).
# Phải trùng chính xác với QLCL_API_KEY trong .env của từng app XN.
#
# CÁCH TẠO KEY (chạy 1 lần, lưu kết quả vào đây VÀ vào .env bên app XN):
#   PowerShell:
#     [Convert]::ToBase64String((1..24 | ForEach-Object { Get-Random -Max 256 }))
#   Python:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Để trống → bỏ qua xác thực (chỉ dùng cho dev/test nội bộ, KHÔNG dùng production).
QLCL_API_KEY=

# Kết nối SQL Server chuyền treo — CHỈ DÙNG CHO DEV LOCAL
# (khi cả QLCL và hanging line cùng chạy trên 1 máy, dùng PULL sync cũ)
# Trong production: XÓA hoặc comment các dòng này — mỗi XN tự PUSH sang QLCL.
# HANGING_LINE_SQL_SERVER=.\SQLEXPRESS
# HANGING_LINE_APP_DB=hanging_app
# HANGING_LINE_SQL_DRIVER=ODBC Driver 17 for SQL Server


# -----------------------------------------------------------------------------
# AUTO SYNC (tùy chọn)
# -----------------------------------------------------------------------------
QTCN_AUTO_SYNC_ENABLED=true
QTCN_AUTO_SYNC_INTERVAL_MINUTES=60
